experiment:
  name: 'V3_3dvar_OIE120km_WarmStart_70kmL84'

build:
  mpas bundle: /glade/campaign/mmm/parc/bjung/stratosphericModeling/V3/code/mpas-bundle/build_single/
  #forecast directory: ''
  bundle compiler used: gnu-openmpi

externalanalyses:
  resource: "GFS.PANDAC"
  resources:
    GFS:
      PANDAC:
        120kmL84:
          directory: "/glade/campaign/mmm/parc/bjung/stratosphericModeling/V3/mpas_init/output_70km"

firstbackground:
  resource: "PANDAC.GFS"
  resources:
    PANDAC:
      GFS:
        120kmL84:
          directory: "/glade/campaign/mmm/parc/bjung/stratosphericModeling/V3/mpas_1st_background/output_70km/{{FirstCycleDate}}"

invariantstream: #BJ: Tricky
  resources:
    defaults:
      InvariantDirectory: /glade/campaign/mmm/parc/bjung/stratosphericModeling/V3/mpas_init/output_70km

forecast:
  post: [verifymodel]
  job:
    120kmL84: #Copied from 120km, Revise this
      nodes: 1
      PEPerNode: 128
      baseSeconds: 60
      secondsPerForecastHR: 30

hofx:  #need this ?
  job:
    120kmL84:
      seconds: 800
      nodes: 1
      PEPerNode: 128
      memory: 235GB

initic:  #need this ?
  job:
    120kmL84:
      seconds: 120
      nodes: 1
      PEPerNode: 128

members:
  n: 1

model:
  outerMesh: 120kmL84
  innerMesh: 120kmL84
  ensembleMesh: 120kmL84
  resources:
    120kmL84:
      meshRatio: 1
      nCells: 40962
      TimeStep: 720.0
      DiffusionLengthScale: 120000.0
      RadiationLWInterval: 00:30:00
      RadiationSWInterval: 00:30:00
      PhysicsSuite: mesoscale_reference
      Microphysics: mp_wsm6
      Convection: cu_ntiedtke
      PBL: bl_ysu
      Gwdo: bl_ysu_gwdo
      RadiationCloud: cld_fraction
      RadiationLW: rrtmg_lw
      RadiationSW: rrtmg_sw
      SfcLayer: sf_monin_obukhov_rev
      LSM: sf_noah

observations:
  resource: PANDACArchiveForVarBC

variational:
  DAType: 3dvar
  biasCorrection: True
  nInnerIterations: [60,60,]
  post: [verifyobs]
  ensemble:
    forecasts:
      PANDAC:
        GEFS:
          120kmL84:
            #...
    localization:
      120kmL84:
        #...
  covariance:
    bumpCovPrefix: mpas
    bumpCovVBalPrefix: mpas
    120kmL84: #Copied from 120km. Revise this!  #BJJ Revise this!!
      bumpCovDir: /glade/campaign/mmm/parc/bjung/stratosphericModeling/V3/HTsampleDataL84/04_global120km_2mn/NICAS.split/merge
      bumpCovStdDevFile: /glade/campaign/mmm/parc/bjung/stratosphericModeling/V3/HTsampleDataL84/04_global120km_2mn/HDIAG_VAR/merge/mpas.stddev.nc
      bumpCovVBalDir: /glade/campaign/mmm/parc/bjung/stratosphericModeling/V3/HTsampleDataL84/04_global120km_2mn/VBAL
      hybridCoefficientsDir: /glade/campaign/mmm/parc/liuz/pandac_hybrid/120km.allsky_hybrid  #TODO: Revise this!
  job:
    120kmL84:
      120kmL84:
        3dvar: #Copied from 120km, Revise this!
          nodes: 1
          PEPerNode: 128
          memory: 235GB
          baseSeconds: 450 #400; failed for 20180503T18

verifymodel:
  job:
    120kmL84: #Copied from 120km, Revise this!
      seconds: 400
      secondsPerMember: 100

workflow:
  first cycle point: 20180414T18
  #restart cycle point: 20180416T00
  restart cycle point: 20180503T18
  final cycle point: 20180514T18

hpc:
  CriticalAccount: nmmm0015
  NonCriticalAccount: nmmm0015
  CriticalPriority: economy
  NonCriticalPriority: economy
