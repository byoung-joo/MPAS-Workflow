suite: ForecastFromExternalAnalyses

experiment:
  name: 'V3_O3_Clim_O120km_ColdStart'

build:
  mpas bundle: /glade/derecho/scratch/bjung/panda-c/code_stratosphere/mpas-bundle/build_single/
  bundle compiler used: gnu-openmpi
  forecast directory: /glade/campaign/mmm/parc/bjung/stratosphericModeling/V3/code/MPAS-Model.8.3.1_ozone_high_top_mods

extendedforecast:
  execute: False # uncomment if forecasts are already completed
  meanTimes: T00
  ensTimes: None
  lengthHR: 24 #120
  outIntervalHR: 6
  DACycling: False
  updateSea: False  #BJJ True
  post: [verifymodel,verifyobs]  #[verifymodel] #verifymodel,verifyobs
  job:  #BJJ: Q: This doesn't seem to work. "job" seems to come from "forecast"
    120kmL84: #Copied from 120km, Revise this
      nodes: 1
      PEPerNode: 128
      baseSeconds: 60
      secondsPerForecastHR: 10 #30
#2026-02-02T16:21:04-07:00 [STDERR] your declared wallclock time (60060 seconds)
#2026-02-02T16:21:04-07:00 [STDERR] exceeds your maximum limit of 43200 seconds

externalanalyses:
  resource: "GFS.PANDAC"
  resources:
    GFS:
      PANDAC:
        120kmL84:
          directory: "/glade/derecho/scratch/bjung/stratosphere/opp_testing/mpas_init/output_70km"

invariantstream: #BJ: Tricky
  resources:
    defaults:
      InvariantDirectory: /glade/derecho/scratch/bjung/stratosphere/opp_testing/mpas_init/output_70km

forecast:
  execute: false
  post: []
  job:
    120kmL84: #Copied from 120km, Revise this
      nodes: 1
      PEPerNode: 128
      baseSeconds: 60
      secondsPerForecastHR: 10
#    GPUPerNode: 0  #BJJ: need this when "build.forecast directory" is set ?. ---> No. Automatically detected. No need to set if everything is on CPU

hofx:  #need this ?
  job:
    120kmL84:
      seconds: 800
      nodes: 1
      PEPerNode: 128
      memory: 235GB
  retainObsFeedback: True
  observers: [
    sfc,
    sondes,
    gnssrobndropp1d,
    amsua_metop-b,
    amsua_n15,
    amsua_n19,
    omps_toz_npp,
    omps_toz_n20,
    omps_toz_n21,
]

members:
  n: 1

observations:
  resource: PANDACArchiveForVarBC

model:
  outerMesh: 120kmL84
  innerMesh: 120kmL84
  ensembleMesh: 120kmL84
  resources:
    120kmL84:
      meshRatio: 1
      nCells: 40962
      TimeStep: 720.0
      DiffusionLengthScale: 120000.0
      RadiationLWInterval: 00:30:00
      RadiationSWInterval: 00:30:00
      PhysicsSuite: mesoscale_reference
      Microphysics: mp_wsm6
      Convection: cu_ntiedtke
      PBL: bl_ysu
      Gwdo: bl_ysu_gwdo
      RadiationCloud: cld_fraction
      RadiationLW: rrtmg_lw
      RadiationSW: rrtmg_sw
      SfcLayer: sf_monin_obukhov_rev
      LSM: sf_noah

verifymodel:
  job:
    120kmL84: #Copied from 120km, Revise this!
      seconds: 400
      secondsPerMember: 100

workflow:
  first cycle point: 20250414T00
  final cycle point: 20250414T00
  max active cycle points: 4

hpc:
  CriticalAccount: nmmm0015
  NonCriticalAccount: nmmm0015
  CriticalQueue: main
  NonCriticalQueue: main
